name: terraform-validate-build

on:
  workflow_call:
    inputs:
      workingDirectoryBase:
        required: true
        type: string
      terraformVersion:
        required: true
        type: string
      artifactName:
        required: true
        type: string

jobs:
  validate-and-package:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ inputs.terraformVersion }}

      - name: Validate Terraform syntax (recursive)
        shell: bash
        run: |
          set -euo pipefail

          WORKING_DIR_BASE="${{ inputs.workingDirectoryBase }}"
          echo "Working Directory Base: $WORKING_DIR_BASE"

          if [[ -z "$WORKING_DIR_BASE" ]]; then
            echo "Error: Working Directory Base not set" >&2
            exit 2
          fi

          WORKING_DIR_BASE="$(cd "$WORKING_DIR_BASE" && pwd)"

          mapfile -t tf_dirs < <(find "$WORKING_DIR_BASE" -type f -name '*.tf' -printf '%h\n' | sort -u)

          if [[ ${#tf_dirs[@]} -eq 0 ]]; then
            echo "No Terraform directories found under: $WORKING_DIR_BASE"
            exit 0
          fi

          for dir in "${tf_dirs[@]}"; do
            echo "Validating: $dir"
            (
              cd "$dir"

              terraform init -backend=false
              terraform validate
            )
          done

          echo "All Terraform validations passed"

      - name: Upload Terraform source artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ inputs.artifactName }}-${{ github.run_number }}
          path: ${{ inputs.workingDirectoryBase }}
